# This repository is a Unity project nested under client/unbuilt.
# These rules keep generated Unity 6 artifacts out of version control.

client/unbuilt/.utmp/
client/unbuilt/[Ll]ibrary/
client/unbuilt/[Tt]emp/
client/unbuilt/[Oo]bj/
client/unbuilt/[Bb]uild/
client/unbuilt/[Bb]uilds/
client/unbuilt/[Ll]ogs/
client/unbuilt/[Uu]ser[Ss]ettings/
client/unbuilt/*.log

# By default Unity supports Blender asset imports. *.blend1 files do not need to be committed.
client/unbuilt/*.blend1
client/unbuilt/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data.
client/unbuilt/[Mm]emoryCaptures/

# Recordings can get excessive in size.
client/unbuilt/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin.
# client/unbuilt/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin.
client/unbuilt/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider personal-layer settings.
client/unbuilt/*.DotSettings.user

# Visual Studio cache directory.
client/unbuilt/.vs/

# VS Code workspace settings.
client/unbuilt/.vscode/

# IntelliJ / Rider workspace settings.
client/unbuilt/.idea/

# Gradle cache directory.
client/unbuilt/.gradle/

# Autogenerated VS/MD/Consulo solution and project files.
client/unbuilt/ExportedObj/
client/unbuilt/.consulo/
client/unbuilt/*.csproj
client/unbuilt/*.unityproj
client/unbuilt/*.sln
client/unbuilt/*.slnx
client/unbuilt/*.suo
client/unbuilt/*.tmp
client/unbuilt/*.user
client/unbuilt/*.userprefs
client/unbuilt/*.pidb
client/unbuilt/*.booproj
client/unbuilt/*.svd
client/unbuilt/*.pdb
client/unbuilt/*.mdb
client/unbuilt/*.opendb
client/unbuilt/*.VC.db

# Unity3D generated meta files.
client/unbuilt/*.pidb.meta
client/unbuilt/*.pdb.meta
client/unbuilt/*.mdb.meta

# Unity3D generated file on crash reports.
client/unbuilt/sysinfo.txt

# Mono auto-generated files.
client/unbuilt/mono_crash.*

# Builds.
client/unbuilt/*.apk
client/unbuilt/*.aab
client/unbuilt/*.unitypackage
client/unbuilt/*.unitypackage.meta
client/unbuilt/*.app

# Crashlytics generated file.
client/unbuilt/crashlytics-build.properties

# TestRunner generated files.
client/unbuilt/InitTestScene*.unity*

# Addressables.
client/unbuilt/ServerData
client/unbuilt/[Aa]ssets/StreamingAssets/aa*
client/unbuilt/[Aa]ssets/AddressableAssetsData/link.xml*
client/unbuilt/[Aa]ssets/Addressables_Temp*
client/unbuilt/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files.
client/unbuilt/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
client/unbuilt/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
client/unbuilt/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
client/unbuilt/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests.
client/unbuilt/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder.
client/unbuilt/[Aa]ssets/[Ss]ceneDependencyCache*
